# =============================================================================
# iSellora Backend Environment Configuration (.env.example)
# Copy this file to backend/.env and insert your actual configuration values.
# IMPORTANT: Never commit backend/.env to Git or expose credentials in logs.
# =============================================================================

# Flask Application Secret Key (Required: Minimum 32 characters in production)
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production

# Mail Server & Password Reset Configuration (Optional for development)
# In development, unset MAIL_SERVER automatically captures reset links in instance/dev_email_outbox.log
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=notifications@isellora.local
MAIL_PASSWORD=example-app-password
MAIL_DEFAULT_SENDER=notifications@isellora.local
APP_BASE_URL=http://127.0.0.1:5000
PASSWORD_RESET_EXPIRY_MINUTES=15

# =============================================================================
# Razorpay Payment Gateway Configuration (Test Mode Only)
# Obtain these from: Razorpay Dashboard -> Settings -> API Keys (Test Mode)
# =============================================================================
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret
