# Flask Application Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-64-character-string-in-production

# Database Configuration (Defaults to SQLite in development, PostgreSQL in production)
# Example for PostgreSQL: postgresql://username:password@localhost:5432/isellora_db
DATABASE_URL=sqlite:///isellora.db

# Admin Configuration
ADMIN_EMAIL=admin@isellora.local

# Server Security & Cookie Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=52428800

# Mail Server & Password Reset Configuration (Optional for local dev - logs to instance/dev_email_outbox.log when unset)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=notifications@isellora.local
# MAIL_PASSWORD=example-app-password
# MAIL_DEFAULT_SENDER=notifications@isellora.local
# APP_BASE_URL=http://127.0.0.1:5000
# PASSWORD_RESET_EXPIRY_MINUTES=15

# Razorpay Payment Gateway Configuration (Test Mode Credentials)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret
